---
extends: default

# .github is linted: workflow YAML is the largest chunk of YAML in the repo.
ignore:
  - .ansible/
  - .git/
  - .venv/

rules:
  braces:
    max-spaces-inside: 1
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  line-length: disable
  # GitHub Actions requires the "on:" key, which YAML 1.1 reads as a boolean.
  truthy:
    check-keys: false
